# Copiar a /etc/certisena/certisena.env y reemplazar todos los valores de ejemplo.
DATABASE_URL=postgresql+asyncpg://USUARIO:CONTRASENA_CODIFICADA@HOST:5432/BASE
SECRET_KEY=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
APP_BASE_URL=https://certisena.example.com

# Redis debe escuchar solo en localhost, no exponer su puerto a Internet.
REDIS_URL=redis://127.0.0.1:6379/0

# Un único worker permite que el arranque automático del esquema no se ejecute en paralelo.
PREPARAR_BASE=auto
SQL_ECHO=0
DB_POOL_SIZE=1
DB_MAX_OVERFLOW=1
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=600

# Correo. Dejar vacío solo si el proyecto no enviará notificaciones por email.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
MAIL_FROM_NAME=CertiSENA ISO

# Firma digital: cargar <id_usuario>.p12 por cada líder y configurar sus claves
# y las CA de confianza antes de habilitar firmas en producción.
CERTIFICADOS_FIRMA_DIR=/etc/certisena/firma
CERTIFICADOS_FIRMA_PASSWORDS_JSON='{}'
CERTIFICADOS_FIRMA_TRUST_ROOTS_JSON='[]'
CERTIFICADOS_STORAGE_DIR=/var/lib/certisena/certificados_firmados
COMITE_ACTAS_STORAGE_DIR=/var/lib/certisena/actas_comite
